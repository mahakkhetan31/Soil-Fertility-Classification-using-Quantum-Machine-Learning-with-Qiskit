   "source": [
    "# Soil Quality Prediction using Quantum Machine Learning\n",
    "## Final Stage 6: Classical vs. Quantum Model Benchmarking & Project Summary\n",
    "\n",
    "**Objective:** Unified empirical comparison of Classical ML models (Random Forest, Gradient Boosting, SVM, Logistic Regression) against Quantum Machine Learning (4-Qubit QSVC) on the Soil Fertility Dataset (`dataset1.csv`).\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Package Dependencies & Environment Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies in Google Colab\n",
    "!pip install -q qiskit qiskit-machine-learning qiskit-algorithms pandas numpy scikit-learn matplotlib seaborn"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Final Model Performance Comparison Table & Visualizations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Summary DataFrame of empirical experimental results\n",
    "results_summary = pd.DataFrame([\n",
    "    {'Model': 'Random Forest (12 Features)', 'Accuracy': 0.8920, 'Macro Precision': 0.5958, 'Macro Recall': 0.6227, 'Macro F1': 0.6088, 'Weighted F1': 0.8714},\n",
    "    {'Model': 'Gradient Boosting (12 Features)', 'Accuracy': 0.8750, 'Macro Precision': 0.7246, 'Macro Recall': 0.7246, 'Macro F1': 0.7246, 'Weighted F1': 0.8750},\n",
    "    {'Model': 'Logistic Regression (12 Features)', 'Accuracy': 0.8580, 'Macro Precision': 0.5775, 'Macro Recall': 0.5977, 'Macro F1': 0.5856, 'Weighted F1': 0.8383},\n",
    "    {'Model': 'SVM RBF Kernel (12 Features)', 'Accuracy': 0.8352, 'Macro Precision': 0.5637, 'Macro Recall': 0.5814, 'Macro F1': 0.5698, 'Weighted F1': 0.8158},\n",
    "    {'Model': 'Quantum SVC (4-Qubit QSVC)', 'Accuracy': 0.7955, 'Macro Precision': 0.5355, 'Macro Recall': 0.5538, 'Macro F1': 0.5424, 'Weighted F1': 0.7768}\n",
    "]).sort_values(by='Macro F1', ascending=False)\n",
    "\n",
    "print(\"=== FINAL MODEL PERFORMANCE COMPARISON ===\")\n",
    "results_summary"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Comparative Visualizations (Accuracy & F1-Score)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))\n",
    "colors = ['#27ae60' if 'Quantum' in m else '#2980b9' for m in results_summary['Model']]\n",
    "\n",
    "# Accuracy Bar Chart\n",
    "sns.barplot(data=results_summary, x='Accuracy', y='Model', palette=colors, ax=axes[0])\n",
    "axes[0].set_title(\"Model Accuracy Comparison\", fontsize=13, fontweight='bold')\n",
    "axes[0].set_xlim(0, 1.0)\n",
    "for p in axes[0].patches:\n",
    "    w = p.get_width()\n",
    "    axes[0].annotate(f\"{w*100:.2f}%\", (w - 0.12, p.get_y() + p.get_height() / 2.),\n",
    "                     ha='center', va='center', color='white', fontweight='bold')\n",
    "\n",
    "# F1-Score Bar Chart\n",
    "f1_melt = pd.melt(results_summary, id_vars=['Model'], value_vars=['Macro F1', 'Weighted F1'], var_name='F1 Type', value_name='Score')\n",
    "sns.barplot(data=f1_melt, x='Score', y='Model', hue='F1 Type', palette=['#8e44ad', '#f39c12'], ax=axes[1])\n",
    "axes[1].set_title(\"F1-Score Comparison (Macro vs. Weighted)\", fontsize=13, fontweight='bold')\n",
    "axes[1].set_xlim(0, 1.0)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
